# be quiet! Light Mount (373f:0002): bind USB interface 03 to usbhid on add.
# Some systems (e.g. Bazzite) do not bind it automatically, so no hidraw node
# appears for the lighting interface. Opt-in only: installed by
# `sudo install/install.sh --usbhid-bind` (ADR-0010, issue #3, R-060 to R-062).
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="373f", ATTRS{idProduct}=="0002", ATTR{bInterfaceNumber}=="03", TAG+="systemd", ENV{SYSTEMD_WANTS}+="lightmount-usbhid-bind@.service"
